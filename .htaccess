# =====================================================================
# CONFIGURACIÓN DE SEGURIDAD Y PROTECCIÓN DE INTRUSIONES (.htaccess)
# MUNICIPALIDAD DE LEBU - SISTEMA DE ÓRDENES DE PEDIDO INTERNO
# =====================================================================

# 1. DESACTIVAR NAVEGACIÓN Y LISTADO DE DIRECTORIOS
Options -Indexes -MultiViews

# 2. SEGUIMIENTO DE SIMLINKS SEGUROS
Options +FollowSymLinks

# 3. OCULTAR CABECERAS DEL SERVIDOR
ServerSignature Off

# 4. CABECERAS DE SEGURIDAD HTTP (SECURITY HEADERS)
<IfModule mod_headers.c>
    # Previene que el navegador interprete archivos con tipos MIME incorrectos (Anti-MIME Sniffing)
    Header set X-Content-Type-Options "nosniff"

    # Previene que el sitio sea embebido en iframes de sitios de terceros (Anti-Clickjacking)
    Header set X-Frame-Options "SAMEORIGIN"

    # Habilita la protección XSS integrada en los navegadores
    Header set X-XSS-Protection "1; mode=block"

    # Política de Referrer para no filtrar información sensible
    Header set Referrer-Policy "strict-origin-when-cross-origin"

    # Desactiva funciones del navegador no utilizadas
    Header set Permissions-Policy "geolocation=(), camera=(), microphone=()"

    # HSTS (Activar en producción con HTTPS exclusivo)
    # Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
</IfModule>

# 5. BLOQUEO DE ARCHIVOS SENSIBLES Y CONFIGURACIONES
<FilesMatch "^\.|\.(sql|log|env|md|json|sh|bak|config|dockerfile|yml|yaml|git.*)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 6. REGLAS DE REESCRITURA Y PREVENCIÓN DE ATAQUES DE INYECCIÓN
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Bloquear peticiones con caracteres nulos o directory traversal (../)
    RewriteCond %{QUERY_STRING} \x00 [NC,OR]
    RewriteCond %{QUERY_STRING} \.\./ [NC,OR]
    RewriteCond %{QUERY_STRING} \.\.\\ [NC]
    RewriteRule ^(.*)$ - [F,L]

    # Bloquear scripts maliciosos y etiquetas script en el Query String (Anti-XSS)
    RewriteCond %{QUERY_STRING} (<|%3C).*script.*(>|%3E) [NC,OR]
    RewriteCond %{QUERY_STRING} GLOBALS(=|\[|\%[0-9A-Z]{2}) [OR]
    RewriteCond %{QUERY_STRING} _REQUEST(=|\[|\%[0-9A-Z]{2})
    RewriteRule ^(.*)$ - [F,L]

    # Bloquear User-Agents de escáneres de vulnerabilidades conocidos
    RewriteCond %{HTTP_USER_AGENT} (nikto|sqlmap|nmap|dirbuster|w3af|acunetix|havij|nessus|netsparker|openvas|fimap) [NC]
    RewriteRule ^(.*)$ - [F,L]

</IfModule>

# 7. MANEJO DE ACCESOS PROHIBIDOS
ErrorDocument 403 /login.php
